<mujoco model="panda peg insertion">
  <include file="mjx_panda.xml"/>

  <statistic center="0.4 0 0.2" extent="0.8"/>

  <option timestep="0.005" iterations="5" ls_iterations="8" integrator="implicitfast">
    <flag eulerdamp="disable"/>
  </option>

  <custom>
    <numeric data="20" name="max_contact_points"/>
  </custom>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".3 .3 .3" specular="0.3 0.3 0.3"/>
    <global azimuth="-40" elevation="-30" offwidth="640" offheight="480"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="0.85 0.9 0.95" width="800" height="800"/>
    <texture type="2d" name="tabletex" builtin="checker" mark="edge" rgb1="0.92 0.92 0.92"
      rgb2="0.85 0.85 0.85" markrgb="0.6 0.6 0.6" width="300" height="300"/>
    <material name="tablemat" texture="tabletex" texuniform="true" texrepeat="10 10" reflectance="0"/>
  </asset>

  <worldbody>
    <light pos="0.5 0 1.5" dir="0 0 -1" directional="true"/>
    <camera name="overview" pos="0.95 -0.5 0.45" xyaxes="0.707 0.707 0 -0.212 0.212 0.707"/>
    <camera name="closeup" pos="0.5 -0.30 0.14" xyaxes="1 0 0 0 0.11 0.3"/>
    <geom name="table" type="box" size="0.5 0.5 0.02" pos="0.4 0 -0.02" material="tablemat"
     contype="0" conaffinity="0" group="1"/>
    <body name="hole_block" mocap="true" pos="0.5 0.0 0">
      <geom name="wall_px" type="box" pos="0.0205000 0 0.015000" size="0.010000 0.0305000 0.015000" contype="0" conaffinity="0" group="1" rgba="0.85 0.45 0.2 0.55"/>
      <geom name="wall_nx" type="box" pos="-0.0205000 0 0.015000" size="0.010000 0.0305000 0.015000" contype="0" conaffinity="0" group="1" rgba="0.85 0.45 0.2 0.55"/>
      <geom name="wall_py" type="box" pos="0 0.0205000 0.015000" size="0.0105000 0.010000 0.015000" contype="0" conaffinity="0" group="1" rgba="0.85 0.45 0.2 0.55"/>
      <geom name="wall_ny" type="box" pos="0 -0.0205000 0.015000" size="0.0105000 0.010000 0.015000" contype="0" conaffinity="0" group="1" rgba="0.85 0.45 0.2 0.55"/>
      <site name="hole_entrance" pos="0 0 0.030000" size="0.002" rgba="0 1 0 1"/>
      <site name="hole_bottom" pos="0 0 0" size="0.002" rgba="1 0 0 1"/>
    </body>
  </worldbody>

  <contact>
    <pair geom1="peg_geom" geom2="wall_px" condim="3" solref="0.01 1" friction="0.6 0.6 0.005 0.0001 0.0001"/>
    <pair geom1="peg_geom" geom2="wall_nx" condim="3" solref="0.01 1" friction="0.6 0.6 0.005 0.0001 0.0001"/>
    <pair geom1="peg_geom" geom2="wall_py" condim="3" solref="0.01 1" friction="0.6 0.6 0.005 0.0001 0.0001"/>
    <pair geom1="peg_geom" geom2="wall_ny" condim="3" solref="0.01 1" friction="0.6 0.6 0.005 0.0001 0.0001"/>
    <pair geom1="peg_geom" geom2="table" condim="3" solref="0.01 1" friction="0.6 0.6 0.005 0.0001 0.0001"/>
  </contact>

  <sensor>
    <force name="peg_force" site="ft_site"/>
    <torque name="peg_torque" site="ft_site"/>
    <framepos name="tip_pos" objtype="site" objname="peg_tip"/>
    <framelinvel name="tip_vel" objtype="site" objname="peg_tip"/>
    <framepos name="hole_pos" objtype="site" objname="hole_entrance"/>
  </sensor>

  <keyframe>
    <key name="home" qpos="0 0.3 0 -1.57079 0 2.0 -0.7853 0.01 0.01"
      ctrl="0 0.3 0 -1.57079 0 2.0 -0.7853 0.01"/>
  </keyframe>
</mujoco>
